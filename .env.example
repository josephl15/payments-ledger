# Local development only. Compose falls back to these values if .env is absent (except LEDGER_JWT_SECRET, below).
# Copy this file to .env (gitignored) to override them.
POSTGRES_DB=ledger
POSTGRES_USER=ledger
POSTGRES_PASSWORD=ledger

# Key that signs login tokens (JWTs). REQUIRED: Compose and the application both refuse to start without it.
# The value below is a fake placeholder and is deliberately too short to be accepted (32+ characters are required),
# so the app fails at startup until you replace it. Generate a real one with:  openssl rand -base64 48
# Never commit the real value: anyone who knows it can forge a token for any user.
LEDGER_JWT_SECRET=REPLACE_ME
